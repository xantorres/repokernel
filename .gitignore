node_modules/
dist/
*.log
.DS_Store
coverage/
.vitest-cache/
*.tsbuildinfo

# Repo-root RepoKernel state is not versioned. The directory is used for
# ad-hoc planning during development of RepoKernel itself. Example
# subprojects under `examples/*/.repokernel/` ship their state as
# fixtures and are intentionally NOT matched here (the leading slash
# anchors this rule to the repo root).
/.repokernel/

# Override global .claude* ignore so the bundled plugin manifest ships with the repo.
!packages/cli/plugin/.claude-plugin/
!packages/cli/plugin/.claude-plugin/**

# fallow analysis cache
.fallow/

# local agent gate (tool-specific tokens; not shipped)
.claude/
