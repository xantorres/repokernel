{
  "name": "@repokernel/core",
  "version": "1.5.4",
  "private": true,
  "description": "RepoKernel core library — schemas, parser, graph, validator, resolver, registry.",
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "git",
    "sprint",
    "validation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xantorres/repokernel.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "execa": "9.5.2",
    "gray-matter": "4.0.3",
    "semver": "7.7.4",
    "yaml": "2.6.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/semver": "7.7.1",
    "@vitest/coverage-v8": "2.1.8",
    "tsup": "8.3.5",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
