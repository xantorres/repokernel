{
  "name": "repokernel",
  "version": "1.5.4",
  "description": "Local-first Git-native control plane for autonomous coding agents.",
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "git",
    "sprint",
    "workflow",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xantorres/repokernel.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "repokernel": "./dist/index.js",
    "rk": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "commander": "12.1.0",
    "gray-matter": "4.0.3",
    "picocolors": "1.1.1",
    "semver": "7.7.4",
    "yaml": "2.6.1"
  },
  "devDependencies": {
    "@repokernel/core": "workspace:*",
    "@types/node": "22.10.2",
    "@types/semver": "7.7.1",
    "@vitest/coverage-v8": "2.1.8",
    "tsup": "8.3.5",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
