  },
  "dependencies": {
    "@repokernel/core": "workspace:*",
    "commander": "12.1.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsup": "8.3.5",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
