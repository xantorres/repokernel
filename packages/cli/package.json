{
  "name": "repokernel",
  "version": "1.33.1",
  "description": "Run AI coding tasks in isolated Git worktrees, with checks before merge.",
  "keywords": [
    "ai",
    "agents",
    "git",
    "worktree",
    "cli",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xantorres/repokernel.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "repokernel": "dist/index.js",
    "rk": "dist/index.js"
  },
  "files": [
    "dist",
    "plugin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "pnpm --filter @repokernel/core build && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "commander": "12.1.0",
    "gray-matter": "4.0.3",
    "picocolors": "1.1.1",
    "semver": "7.7.4",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@repokernel/core": "workspace:*",
    "@types/node": "22.10.2",
    "@types/semver": "7.7.1",
    "@vitest/coverage-v8": "3.2.6",
    "tsup": "8.5.1",
    "typescript": "5.7.2",
    "vitest": "3.2.6"
  }
}
