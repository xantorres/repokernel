{
  "name": "@repokernel/cli",
  "version": "0.0.0",
  "private": true,
  "description": "RepoKernel CLI: validate, status, next, registry.",
  "type": "module",
  "bin": {
    "repokernel": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
